# Mac と Windows で改行コードをそろえる
* text=auto

# Unity の YAML ファイルは LF に固定する
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.cs         text eol=lf
*.json       text eol=lf

# バイナリ
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
