        "properties": {
          "imageBase64": {
            "type": "string",
            "maxLength": 4000000,
            "minLength": 1,
            "title": "Imagebase64"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png"
            ],
            "title": "Mimetype",
            "default": "image/jpeg"
          },
          "candidateSignIds": {
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Candidatesignids"
          }
        },
        "type": "object",
        "required": [
          "imageBase64",
          "candidateSignIds"
        ],
