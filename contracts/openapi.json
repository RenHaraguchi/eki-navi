          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "engine": {
            "type": "string",
            "enum": [
              "gemini",
              "dictionary",
              "stub"
            ],
            "title": "Engine"
          },
          "latencyMs": {
            "type": "integer",
            "title": "Latencyms"
          },
          "packVersion": {
            "type": "string",
            "title": "Packversion"
          }
        },
        "type": "object",
        "required": [
          "status",
          "candidates",
          "engine",
          "latencyMs",
          "packVersion"
        ],
        "title": "DestinationResponse",
        "description": "行き先の判定の結果。\n\nstatus の意味:\n- ok: candidates の先頭をそのまま使ってよい\n- ambiguous: 利用者に candidates から選んでもらう\n- out_of_scope: 対応外。行き先の一覧を出す\n- unavailable: 判定できなかった。行き先の一覧を出す"
      },
      "GateOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
