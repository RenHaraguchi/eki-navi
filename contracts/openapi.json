          "matchScore": {
            "type": "number",
            "title": "Matchscore",
            "description": "読んだ文字といちばん近い候補の重なり（0〜1）"
          },
          "engine": {
            "type": "string",
            "enum": [
              "gemini",
              "dictionary",
              "stub"
