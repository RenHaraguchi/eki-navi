        "description": "カメラの画像から案内板を見分ける問い合わせ。"
      },
      "SignIdentifyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_found",
              "unavailable"
            ],
            "title": "Status"
          },
          "signId": {
            "type": "string",
            "title": "Signid"
          },
